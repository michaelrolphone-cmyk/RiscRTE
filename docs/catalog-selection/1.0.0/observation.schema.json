{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_version",
    "binding",
    "session_usable",
    "namespaces",
    "files",
    "parents"
  ],
  "properties": {
    "observation_version": {
      "const": "1.0.0"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "container_sha256",
        "inventory_sha256",
        "context_sha256",
        "firmware_id",
        "session"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "container_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "firmware_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511
        },
        "session": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "session_usable": {
      "type": "boolean"
    },
    "namespaces": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace_id",
          "writable"
        ],
        "properties": {
          "namespace_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
          },
          "writable": {
            "type": "boolean"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "volume",
          "destination",
          "namespace_id",
          "current"
        ],
        "properties": {
          "volume": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511
          },
          "namespace_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
          },
          "current": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status"
                ],
                "properties": {
                  "kind": {
                    "const": "absent"
                  },
                  "status": {
                    "const": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status",
                  "flags"
                ],
                "properties": {
                  "kind": {
                    "const": "directory"
                  },
                  "status": {
                    "const": 0
                  },
                  "flags": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status",
                  "flags",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "status": {
                    "const": 0
                  },
                  "flags": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status"
                ],
                "properties": {
                  "kind": {
                    "const": "error"
                  },
                  "status": {
                    "type": "integer",
                    "not": {
                      "enum": [
                        0,
                        1
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "uncertain"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "parents": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "volume",
          "destination",
          "namespace_id",
          "current"
        ],
        "properties": {
          "volume": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511
          },
          "namespace_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
          },
          "current": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status"
                ],
                "properties": {
                  "kind": {
                    "const": "absent"
                  },
                  "status": {
                    "const": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status",
                  "flags"
                ],
                "properties": {
                  "kind": {
                    "const": "directory"
                  },
                  "status": {
                    "const": 0
                  },
                  "flags": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status",
                  "flags",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "status": {
                    "const": 0
                  },
                  "flags": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status"
                ],
                "properties": {
                  "kind": {
                    "const": "error"
                  },
                  "status": {
                    "type": "integer",
                    "not": {
                      "enum": [
                        0,
                        1
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "uncertain"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
