{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog payload manifest reference 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest",
    "container"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "asset_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "asset_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    }
  }
}
