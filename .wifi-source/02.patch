+int32_t Port::radioStationBegin(void* context,uint64_t token,const risc_wifi_station_request_v1* request,uint32_t* out){
+  if(out)*out=0;
+  auto& c=*static_cast<Radio*>(context);auto& p=*c.port;
+  if(!request||!out||request->struct_size!=sizeof(*request))return RISC_RADIO_INVALID;
+  if(!p.available()||p.sleepRetained_||p.transferring_||!token||token!=c.token)return RISC_RADIO_INVALID;
+  const auto *api=risc_native_wifi_station_get_v1(p.hw_.radioAsync);
+  if(!api||c.asyncUnavailable)return RISC_RADIO_UNAVAILABLE;
+  if(c.active||c.closing||c.operation||c.serviceLease||p.iq_.token||p.hci_.closing||(p.hw_.hciSafe&&!p.hw_.hciSafe()))return RISC_RADIO_BUSY;
+  const int32_t result=api->begin_station(request,out);
+  if(result==RISC_RADIO_ACCEPTED){
+    if(!*out){c.closing=true;return RISC_RADIO_RETAINED;}
+    c.operation=*out;c.completed=0;c.active=true;c.scanning=request->operation.kind==RISC_RADIO_REQUEST_SCAN;
+  }
+  return result;
+}
+int32_t Port::radioStationObserve(void* context,uint64_t token,uint32_t operation,risc_wifi_station_observation_v1* out){
+  auto& c=*static_cast<Radio*>(context);auto& p=*c.port;
+  if(!out||out->struct_size!=sizeof(*out)||!operation)return RISC_RADIO_INVALID;
+  if(!p.hw_.owner||!p.hw_.owner()||p.sleeping_||p.sleepRetained_||p.transferring_||!token||token!=c.token)return RISC_RADIO_INVALID;
+  const auto *api=risc_native_wifi_station_get_v1(p.hw_.radioAsync);if(!api)return RISC_RADIO_UNAVAILABLE;
+  if(operation!=c.operation&&operation!=c.completed)return RISC_RADIO_STALE;
+  const int32_t result=api->observe(operation,out);
+  if(result==RISC_RADIO_ACCEPTED){
+    bool valid=out->struct_size==sizeof(*out)&&out->operation_id==operation&&out->failure<=RISC_WIFI_ERROR_LINK_LOST&&
+      out->internet<=RISC_WIFI_INTERNET_UNREACHABLE&&!(out->flags&~31u)&&out->scan.struct_size==sizeof(out->scan)&&
+      out->scan.count<=GARDEN_RADIO_SCAN_MAX&&out->scan.state<=GARDEN_RADIO_SCAN_FAILED&&!out->scan.reserved&&out->channel<=14&&
+      strnlen(out->ssid,sizeof(out->ssid))<=32&&!out->reserved&&!out->reserved2[0]&&!out->reserved2[1];
+    for(auto b:out->reserved3)if(b)valid=false;
+    for(unsigned i=0;i<out->scan.count;i++)if(strnlen(out->scan.entries[i].ssid,33)>32||out->scan.entries[i].channel>14||out->scan.entries[i].reserved)valid=false;
+    if(!valid){c.closing=true;return RISC_RADIO_RETAINED;}
+  }
+  return result;
+}
+int32_t Port::radioStationRequest(void* context,uint64_t token,uint32_t operation,uint32_t command){
+  auto& c=*static_cast<Radio*>(context);auto& p=*c.port;
+  if(!p.available()||p.sleepRetained_||p.transferring_||!token||token!=c.token)return RISC_RADIO_INVALID;
+  if(!operation||operation!=c.operation)return RISC_RADIO_STALE;
+  if(c.closing||c.serviceLease||!p.tcpIdle()||(p.hw_.httpIdle&&!p.hw_.httpIdle()))return RISC_RADIO_BUSY;
+  const auto *api=risc_native_wifi_station_get_v1(p.hw_.radioAsync);
+  return api?api->request(operation,command):RISC_RADIO_UNAVAILABLE;
+}
