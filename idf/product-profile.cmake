# Optional product-owned profile. Hardware remains selected through the existing
# native hooks/provider graph; this interface only owns build selection.
if(DEFINED RISC_PRODUCT_PROFILE)
    get_filename_component(RISC_RUNTIME_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
    get_filename_component(RISC_PRODUCT_PROFILE "${RISC_PRODUCT_PROFILE}" REALPATH)
    if(NOT EXISTS "${RISC_PRODUCT_PROFILE}")
        message(FATAL_ERROR "Missing exact product profile")
    endif()
    include("${RISC_PRODUCT_PROFILE}")
    foreach(required RISC_NATIVE_TARGET RISC_NATIVE_PARTITIONS)
        if(NOT DEFINED ${required})
            message(FATAL_ERROR "Product profile must declare ${required}")
        endif()
    endforeach()
    if(NOT RISC_NATIVE_TARGET MATCHES "^[a-zA-Z0-9_.-]+$")
        message(FATAL_ERROR "Invalid native product identity")
    endif()
    if(NOT EXISTS "${RISC_NATIVE_PARTITIONS}")
        message(FATAL_ERROR "Missing product partition table")
    endif()
    foreach(definition IN LISTS RISC_NATIVE_DEFINITIONS)
        if(definition MATCHES "^(ARDUINO|CONFIG_)")
            message(FATAL_ERROR "Product definitions may not change the native SDK cohort")
        endif()
    endforeach()
    foreach(pair "RISC_NATIVE_APPDATA|RISC_NATIVE_APP_DATA_MOUNT=1" "RISC_NATIVE_IQ|RISC_ENABLE_RADIO_IQ=1")
        string(REPLACE "|" ";" fields "${pair}")
        list(GET fields 0 selection)
        list(GET fields 1 definition)
        list(FIND RISC_NATIVE_DEFINITIONS "${definition}" present)
        if((${selection} AND present EQUAL -1) OR (NOT ${selection} AND NOT present EQUAL -1))
            message(FATAL_ERROR "Product ${selection} must match ${definition}")
        endif()
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/product-sdkconfig.defaults"
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${RISC_NATIVE_PARTITIONS}\"\n")
    list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_BINARY_DIR}/product-sdkconfig.defaults")
endif()
if(NOT DEFINED RISC_NATIVE_TARGET)
    set(RISC_NATIVE_TARGET "esp32s3-native-idf61")
endif()
